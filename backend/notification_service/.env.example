# Environment configuration for notification service
# Copy this to .env and configure with your actual values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://notification_user:notification_pass@postgres:5432/taskly_notifications

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# SMTP Configuration (using MailHog for development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SENDER_EMAIL=noreply@taskly.com
SENDER_NAME=Taskly Notifications

# Production SMTP Configuration (commented out)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# SENDER_EMAIL=your-email@gmail.com
# SENDER_NAME=Your App Name